# Career Direction Engine — environment template
#
# Copy to .env.local for local dev:  cp .env.local.example .env.local
# .env.local is git-ignored; THIS file is committed (see .gitignore exception).
#
# ⚠️ DATA-SOURCE FLAGS ARE PRODUCTION-CRITICAL. If ROME_SOURCE / OFFER_SOURCE are
#    unset or empty, the engine SILENTLY falls back to the tiny bundled `fixture`
#    dataset (see src/lib/rome/index.ts + src/lib/offers/index.ts). On production
#    that surfaces nonsense results (thin generic matches, no real market). This
#    already caused a live incident — always set BOTH to `live` in any real deploy.

# --- Data layer seam (PRD §3) — REQUIRED in production -----------------------
# fixture = read /fixtures/*.json (tiny test set). live = Supabase ROME graph +
# France Travail offer cache. MUST be `live` in preview & production.
ROME_SOURCE=live
OFFER_SOURCE=live

# --- Supabase (PRD §9) — REQUIRED (ROME graph, offer cache, quiz_sessions) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- France Travail Offres API v2 (PRD §3) — REQUIRED for live offer ingest ---
# Never commit real values. Rotate any secret that has been exposed.
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# --- Engine tuning knobs — OPTIONAL (code defaults are the locked values) -----
# Leave unset to use the calibrated defaults. Override only for a tuning sweep.
# COHERENCE_K=0.20              # diminishing-returns thinning (coherence.ts)
# COHERENCE_FORMULA=strength    # strength | plain
# WILDCARD_FLOOR_FRAC=0.5       # cross-domain wildcard credibility floor
# RARITY_GENERIC_FLOOR=3        # generic-skill idf floor (graph-direction-proposer.ts)
# STRONG_COVERAGE=              # apply_now bucket coverage threshold (bucketer.ts)
