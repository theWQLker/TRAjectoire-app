# Career Direction Engine — environment template
#
# Copy to .env.local for local dev:  cp .env.local.example .env.local
# .env.local is git-ignored; THIS file is committed.
#
# ⚠️ DATA-SOURCE FLAGS DECIDE WHETHER RESULTS ARE REAL. If ROME_SOURCE /
#    OFFER_SOURCE are UNSET, the engine SILENTLY uses the tiny bundled `fixture`
#    dataset (src/lib/rome/index.ts, src/lib/offers/index.ts). That is fine for a
#    zero-config demo, but a deploy meant to show REAL market data that forgets the
#    flags will look normal while surfacing thin generic matches and no real
#    market. This already caused a live incident on the prototype. For any
#    real-data deploy, set BOTH to `live` — see DEPLOY.md.

# --- Data layer seam ----------------------------------------------------------
# fixture = bundled /fixtures JSON (zero external services — demo mode).
# live    = Supabase ROME graph + cached France Travail offers (needs Supabase below).
ROME_SOURCE=fixture
OFFER_SOURCE=fixture

# --- Supabase — REQUIRED when either flag is `live` ---------------------------
# Also used for session persistence; absent → in-memory session store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- France Travail Offres API v2 — only for offer ingest scripts -------------
# Never commit real values. Rotate any secret that has been exposed.
FT_CLIENT_ID=
FT_CLIENT_SECRET=
